<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- For source installs: `make install-service PREFIX=~/.local` fills in the path, copies this
     to ~/Library/LaunchAgents/ and loads it. Events and samples go to ~/.local/state/oomguard/. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.github.oomguard</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/oomguard</string>
		<string>run</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardErrorPath</key>
	<string>/tmp/oomguard.err</string>
</dict>
</plist>
